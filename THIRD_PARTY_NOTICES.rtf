use objc2::extern_protocol;\par
use objc2::rc::Retained;\par
use objc2::runtime::NSZone;\par
use objc2::runtime::ProtocolObject;\par
use objc2::Message;\par
\par
/// A helper type for implementing [`NSCopying`].\par
///\par
/// `NSCopying` and `NSMutableCopying` do not in their signatures describe the\par
/// result type from the copying operation. This is problematic, as it means\par
/// that using them ends up falling back to [`AnyObject`], which makes copying\par
/// much less useful and ergonomic.\par
///\par
/// To properly describe this, we need an associated type which describes the\par
/// actual result type from a copy. The associated type can't be present\par
/// directly on the protocol traits themselves, however, since we want to use\par
/// them as e.g. `ProtocolObject<dyn NSCopying>`, so we introduce this helper\par
/// trait instead. See [`MutableCopyingHelper`] for the mutable variant.\par
///\par
/// We might be able to get rid of this hack once [associated type defaults]\par
/// are stabilized.\par
///\par
/// [`AnyObject`]: objc2::runtime::AnyObject\par
/// [associated type defaults]: https://github.com/rust-lang/rust/issues/29661\par
///\par
///\par
/// # Safety\par
///\par
/// The [`Result`] type must be correct.\par
///\par
/// [`Result`]: Self::Result\par
pub unsafe trait CopyingHelper: Message \{\par
    /// The immutable counterpart of the type, or `Self` if the type has no\par
    /// immutable counterpart.\par
    ///\par
    /// The implementation for `NSString` has itself (`NSString`) here, while\par
    /// `NSMutableString` instead has `NSString`.\par
    type Result: Message;\par
\}\par
\par
/// A helper type for implementing [`NSMutableCopying`].\par
///\par
/// See [`CopyingHelper`] for the immutable variant, and more details in\par
/// general. These traits are split to allow implementing\par
/// `MutableCopyingHelper` only when the mutable class is available.\par
///\par
///\par
/// # Safety\par
///\par
/// The [`Result`] type must be correct.\par
///\par
/// [`Result`]: Self::Result\par
pub unsafe trait MutableCopyingHelper: Message \{\par
    /// The mutable counterpart of the type, or `Self` if the type has no\par
    /// mutable counterpart.\par
    ///\par
    /// The implementation for `NSString` has `NSMutableString` here, while\par
    /// `NSMutableString` has itself (`NSMutableString`).\par
    type Result: Message;\par
\}\par
\par
// SAFETY: Superclasses are not in general required to implement the same\par
// traits as their subclasses, but we're not dealing with normal classes and\par
// arbitrary protocols, we're dealing with with immutable/mutable class\par
// counterparts, and the `NSCopying`/`NSMutableCopying` protocols, which\par
// _will_ be implemented on superclasses.\par
unsafe impl<P: ?Sized> CopyingHelper for ProtocolObject<P> \{\par
    type Result = Self;\par
\}\par
\par
// SAFETY: Subclasses are required to always implement the same traits as\par
// their superclasses, so a mutable subclass is required to implement the same\par
// traits too.\par
unsafe impl<P: ?Sized> MutableCopyingHelper for ProtocolObject<P> \{\par
    type Result = Self;\par
\}\par
\par
extern_protocol!(\par
    /// A protocol to provide functional copies of objects.\par
    ///\par
    /// This is similar to Rust's [`Clone`] trait, along with sharing a few\par
    /// similarities to the [`std::borrow::ToOwned`] trait with regards to the\par
    /// output type.\par
    ///\par
    /// To allow using this in a meaningful way in Rust, we have to "enrich"\par
    /// the implementation by also specifying the resulting type, see\par
    /// [`CopyingHelper`] for details.\par
    ///\par
    /// See also [Apple's documentation][apple-doc].\par
    ///\par
    /// [apple-doc]: https://developer.apple.com/documentation/foundation/nscopying\par
    ///\par
    ///\par
    /// # Examples\par
    ///\par
    /// Implement `NSCopying` for an externally defined class.\par
    ///\par
    /// ```\par
    /// use objc2::extern_class;\par
    /// use objc2_foundation::\{CopyingHelper, NSCopying, NSObject\};\par
    ///\par
    /// extern_class!(\par
    ///     #[unsafe(super(NSObject))]\par
    ///     # #[name = "NSData"]\par
    ///     struct ExampleClass;\par
    /// );\par
    ///\par
    /// unsafe impl NSCopying for ExampleClass \{\}\par
    ///\par
    /// // Copying ExampleClass returns another ExampleClass.\par
    /// unsafe impl CopyingHelper for ExampleClass \{\par
    ///     type Result = Self;\par
    /// \}\par
    /// ```\par
    ///\par
    /// Implement `NSCopying` for a custom class.\par
    ///\par
    /// ```\par
    /// use objc2::\{define_class, msg_send, AnyThread, DefinedClass\};\par
    /// use objc2::rc::Retained;\par
    /// use objc2::runtime::NSZone;\par
    /// use objc2_foundation::\{CopyingHelper, NSCopying, NSObject\};\par
    ///\par
    /// define_class!(\par
    ///     #[unsafe(super(NSObject))]\par
    ///     struct CustomClass;\par
    ///\par
    ///     unsafe impl NSCopying for CustomClass \{\par
    ///         #[unsafe(method_id(copyWithZone:))]\par
    ///         fn copyWithZone(&self, _zone: *const NSZone) -> Retained<Self> \{\par
    ///             // Create new class, and transfer ivars\par
    ///             let new = Self::alloc().set_ivars(self.ivars().clone());\par
    ///             unsafe \{ msg_send![super(new), init] \}\par
    ///         \}\par
    ///     \}\par
    /// );\par
    ///\par
    /// // Copying CustomClass returns another CustomClass.\par
    /// unsafe impl CopyingHelper for CustomClass \{\par
    ///     type Result = Self;\par
    /// \}\par
    /// ```\par
    #[allow(clippy::missing_safety_doc)]\par
    pub unsafe trait NSCopying \{\par
        /// Returns a new instance that's a copy of the receiver.\par
        ///\par
        /// The output type is the immutable counterpart of the object, which\par
        /// is usually `Self`, but e.g. `NSMutableString` returns `NSString`.\par
        #[unsafe(method(copy))]\par
        #[unsafe(method_family = copy)]\par
        #[optional]\par
        fn copy(&self) -> Retained<Self::Result>\par
        where\par
            Self: CopyingHelper;\par
\par
        /// Returns a new instance that's a copy of the receiver.\par
        ///\par
        /// This is only used when implementing `NSCopying`, call\par
        /// [`copy`][NSCopying::copy] instead.\par
        ///\par
        ///\par
        /// # Safety\par
        ///\par
        /// The zone pointer must be valid or NULL.\par
        #[unsafe(method(copyWithZone:))]\par
        #[unsafe(method_family = copy)]\par
        unsafe fn copyWithZone(&self, zone: *mut NSZone) -> Retained<Self::Result>\par
        where\par
            Self: CopyingHelper;\par
    \}\par
);\par
\par
extern_protocol!(\par
    /// A protocol to provide mutable copies of objects.\par
    ///\par
    /// Only classes that have an \u8220?immutable vs. mutable\u8221? distinction should\par
    /// adopt this protocol. Use the [`MutableCopyingHelper`] trait to specify\par
    /// the return type after copying.\par
    ///\par
    /// See [Apple's documentation][apple-doc] for details.\par
    ///\par
    /// [apple-doc]: https://developer.apple.com/documentation/foundation/nsmutablecopying\par
    ///\par
    ///\par
    /// # Example\par
    ///\par
    /// Implement [`NSCopying`] and [`NSMutableCopying`] for a class pair like\par
    /// `NSString` and `NSMutableString`.\par
    ///\par
    /// ```ignore\par
    /// // Immutable copies return NSString\par
    ///\par
    /// unsafe impl NSCopying for NSString \{\}\par
    /// unsafe impl CopyingHelper for NSString \{\par
    ///     type Result = NSString;\par
    /// \}\par
    /// unsafe impl NSCopying for NSMutableString \{\}\par
    /// unsafe impl CopyingHelper for NSMutableString \{\par
    ///     type Result = NSString;\par
    /// \}\par
    ///\par
    /// // Mutable copies return NSMutableString\par
    ///\par
    /// unsafe impl NSMutableCopying for NSString \{\}\par
    /// unsafe impl MutableCopyingHelper for NSString \{\par
    ///     type Result = NSMutableString;\par
    /// \}\par
    /// unsafe impl NSMutableCopying for NSMutableString \{\}\par
    /// unsafe impl MutableCopyingHelper for NSMutableString \{\par
    ///     type Result = NSMutableString;\par
    /// \}\par
    /// ```\par
    #[allow(clippy::missing_safety_doc)]\par
    pub unsafe trait NSMutableCopying \{\par
        /// Returns a new instance that's a mutable copy of the receiver.\par
        ///\par
        /// The output type is the mutable counterpart of the object. E.g. both\par
        /// `NSString` and `NSMutableString` return `NSMutableString`.\par
        #[unsafe(method(mutableCopy))]\par
        #[unsafe(method_family = mutableCopy)]\par
        #[optional]\par
        fn mutableCopy(&self) -> Retained<Self::Result>\par
        where\par
            Self: MutableCopyingHelper;\par
\par
        /// Returns a new instance that's a mutable copy of the receiver.\par
        ///\par
        /// This is only used when implementing `NSMutableCopying`, call\par
        /// [`mutableCopy`][NSMutableCopying::mutableCopy] instead.\par
        ///\par
        ///\par
        /// # Safety\par
        ///\par
        /// The zone pointer must be valid or NULL.\par
        #[unsafe(method(mutableCopyWithZone:))]\par
        #[unsafe(method_family = mutableCopy)]\par
        unsafe fn mutableCopyWithZone(&self, zone: *mut NSZone) -> Retained<Self::Result>\par
        where\par
            Self: MutableCopyingHelper;\par
    \}\par
);\par
