### N0043 - SHA-256 23d608079a47693a26dfc8a5cb01894ad0136a50714d46221d9380aa4a4b4423\par
\par
#![cfg(feature = "NSString")]\par
use objc2::\{rc::Retained, runtime::ProtocolObject\};\par
use objc2_foundation::\{NSCopying, NSMutableCopying, NSString\};\par
\par
#[test]\par
fn copy() \{\par
    let obj = NSString::new();\par
    let protocol_object: &ProtocolObject<dyn NSCopying> = ProtocolObject::from_ref(&*obj);\par
    let _: Retained<ProtocolObject<dyn NSCopying>> = protocol_object.copy();\par
\}\par
\par
#[test]\par
fn copy_mutable() \{\par
    let obj = NSString::new();\par
    let protocol_object: &ProtocolObject<dyn NSMutableCopying> = ProtocolObject::from_ref(&*obj);\par
    let _: Retained<ProtocolObject<dyn NSMutableCopying>> = protocol_object.mutableCopy();\par
\}\par
\par
