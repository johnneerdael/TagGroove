#include <stdio.h>\par
#include <stdlib.h>\par
#include <unistd.h>\par
#include <libgen.h>\par
#include <dirent.h>\par
#include <string.h>\par
#include <errno.h>\par
\par
#define die(...)                                    \\\par
    do \{                                            \\\par
        fprintf(stderr, "Error: " __VA_ARGS__);     \\\par
        exit(1);                                    \\\par
    \} while(0);\par
#define SET_NEW_ENV(str,len,fmt,...)                \\\par
    format = fmt;                                   \\\par
    length = strlen(format) + (len);                \\\par
    char *str = calloc(length, sizeof(char));     \\\par
    snprintf(str, length, format, __VA_ARGS__);   \\\par
    putenv(str);\par
#define MAX(a,b)    (a > b ? a : b)\par
#define bool int\par
#define false 0\par
#define true -1\par
\par
#define LINE_SIZE 255\par
\par
int filter(const struct dirent *dir) \{\par
    char *p = (char*) &dir->d_name;\par
    p = strrchr(p, '.');\par
    return p && !strcmp(p, ".desktop");\par
\}\par
\par
int main(int argc, char *argv[]) \{\par
    char *appdir = dirname(realpath("/proc/self/exe", NULL));\par
    if (!appdir)\par
        die("Could not access /proc/self/exe\\n");\par
\par
    int ret;\par
    struct dirent **namelist;\par
    ret = scandir(appdir, &namelist, filter, NULL);\par
\par
    if (ret == 0) \{\par
        die("No .desktop files found\\n");\par
    \} else if(ret == -1) \{\par
        die("Could not scan directory %s\\n", appdir);\par
    \}\par
\par
    /* Extract executable from .desktop file */\par
    char *desktop_file = calloc(LINE_SIZE, sizeof(char));\par
    snprintf(desktop_file, LINE_SIZE, "%s/%s", appdir, namelist[0]->d_name);\par
    FILE *f     = fopen(desktop_file, "r");\par
    char *line  = malloc(LINE_SIZE);\par
    size_t n    = LINE_SIZE;\par
\par
    do \{\par
        if (getline(&line, &n, f) == -1)\par
            die("Executable not found, make sure there is a line starting with 'Exec='\\n");\par
    \} while(strncmp(line, "Exec=", 5));\par
    fclose(f);\par
    char *exe   = line+5;\par
\par
    // parse arguments\par
    bool in_quotes = 0;\par
    for (n = 0; n < LINE_SIZE; n++) \{\par
        if (!line[n])         // end of string\par
            break;\par
        else if (line[n] == 10 || line[n] == 13) \{\par
            line[n] = '\\0';\par
            line[n+1] = '\\0';\par
            line[n+2] = '\\0';\par
            break;\par
        \} else if (line[n] == '"') \{\par
            in_quotes = !in_quotes;\par
        \} else if (line[n] == ' ' && !in_quotes)\par
            line[n] = '\\0';\par
    \}\par
\par
    // count arguments\par
    char*   arg         = exe;\par
    int     argcount    = 0;\par
    while ((arg += (strlen(arg)+1)) && *arg)\par
        argcount += 1;\par
\par
    // merge args\par
    char*   outargptrs[argcount + argc + 1];\par
    outargptrs[0] = exe;\par
    int     outargindex = 1;\par
    arg                 = exe;\par
    int     argc_       = argc - 1;     // argv[0] is the filename\par
    char**  argv_       = argv + 1;\par
    while ((arg += (strlen(arg)+1)) && *arg) \{\par
        if (arg[0] == '%' || (arg[0] == '"' && arg[1] == '%')) \{         // handle desktop file field codes\par
