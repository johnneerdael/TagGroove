# Shell scripts run under Git Bash on Windows CI, which rejects CRLF.
*.sh text eol=lf
# NSIS fixture hashes and production-source extraction require stable LF bytes.
*.nsi text eol=lf
*.nsh text eol=lf
# The generated installer copy is checked byte-for-byte on every host.
THIRD_PARTY_NOTICES.rtf text eol=lf
THIRD_PARTY_NOTICES.rtf linguist-generated
THIRD_PARTY_DEPENDENCIES.md text eol=lf linguist-generated whitespace=-blank-at-eol
THIRD_PARTY_NOTICES.md text eol=lf linguist-generated whitespace=-blank-at-eol
src/licenses/dependency-inventory.json text eol=lf linguist-generated
src/licenses/supplements/** -text linguist-vendored whitespace=-blank-at-eol
THIRD_PARTY_ANDROID.md text eol=lf linguist-generated whitespace=-blank-at-eol
src/licenses/android-inventory.json text eol=lf linguist-generated
src/licenses/android/** -text linguist-vendored whitespace=-blank-at-eol,-blank-at-eof
scripts/notices/*.gradle text eol=lf
