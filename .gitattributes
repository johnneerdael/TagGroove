assets/brand/** linguist-vendored
crates/regex-compat/vendor/** linguist-vendored
docs/evidence/** linguist-generated
src-tauri/gen/** linguist-generated
# Shell scripts run under Git Bash on Windows CI, which rejects CRLF.
*.sh text eol=lf
# NSIS fixture hashes and production-source extraction require stable LF bytes.
*.nsi text eol=lf
*.nsh text eol=lf
# The generated installer copy is checked byte-for-byte on every host.
THIRD_PARTY_NOTICES.rtf text eol=lf

# Native recipe and imported-source byte hashes must survive Windows checkout.
scripts/audio-deps/** text eol=lf
crates/audio-fingerprint/native/** text eol=lf
crates/audio-fingerprint/tests/fixtures/carriers/** -text
