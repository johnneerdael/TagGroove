{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TagGroove",
  "version": "0.2.0",
  "identifier": "org.opentag.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TagGroove",
        "width": 1240,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Open source audio metadata editor",
    "longDescription": "TagGroove \u2014 Tag, Organize, Enjoy. An open source music metadata editor built with Tauri 2 and Rust.",
    "publisher": "TagGroove",
    "homepage": "https://github.com/johnneerdael/TagGroove",
    "license": "MIT AND LGPL-2.1-or-later AND BSD-3-Clause AND Zlib AND bzip2-1.0.6",
    "licenseFile": "../THIRD_PARTY_NOTICES.md",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/icons/hicolor": "icons/linux/hicolor/"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/icons/hicolor": "icons/linux/hicolor/"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor": "icons/linux/hicolor/"
        }
      }
    }
  }
}
